{
  "manifest_version": "0.3",
  "name": "ceiba-cli-pp-mcp",
  "display_name": "Ceiba Realty",
  "version": "0.1.0",
  "description": "All 84 Ceiba listings offline, with market math, comps, and change tracking over a local mirror.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/ceiba-cli-pp-mcp",
    "mcp_config": {
      "command": "${__dirname}/bin/ceiba-cli-pp-mcp",
      "args": []
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ]
  }
}
